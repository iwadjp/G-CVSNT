; --- CVS URL プロトコルハンドラー ---

[HKEY_CLASSES_ROOT\CVS]
@="URL:CVS Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\CVS\DefaultIcon]
@="C:\\Program Files\\TortoiseCVS\\TortoiseAct.exe"

[HKEY_CLASSES_ROOT\CVS\shell\open\command]
@="\"C:\\Program Files\\TortoiseCVS\\TortoiseAct.exe\" -u \"%1\""

; --- TortoiseCVS インストール情報 ---

[HKEY_LOCAL_MACHINE\SOFTWARE\TortoiseCVS]
"RootDir"="C:\\Program Files\\TortoiseCVS\\"
